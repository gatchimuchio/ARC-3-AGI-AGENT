{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.arc3.invalid/schemas/source_profile.schema.json",
  "title": "HDS Distillation SourceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_type",
    "domain",
    "distribution_format",
    "split_role",
    "answer_visibility",
    "development_usage",
    "contamination_class",
    "materialization_state",
    "source_code_access",
    "policy_weight_source",
    "selectors",
    "digest_excluded_fields",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "hds-distillation-source-profile-v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "profile_type": {
      "enum": [
        "ARC2_KAGGLE_CHALLENGE_SOLUTION",
        "ARC2_OFFICIAL_TASK_JSON",
        "ARC2_INTERNAL_NORMALIZED_CORPUS",
        "ARC3_ENVIRONMENT_SOURCE_BUNDLE",
        "ARC3_RAW_TEACHER_RECORDING",
        "ARC3_CANONICAL_TEACHER_TRAJECTORY"
      ]
    },
    "domain": {
      "enum": [
        "ARC2",
        "ARC3"
      ]
    },
    "distribution_format": {
      "type": "string",
      "minLength": 1
    },
    "split_role": {
      "enum": [
        "TRAIN_TEACHER",
        "PUBLIC_EVALUATION_TEACHER",
        "PUBLIC_EVALUATION_CONSUMED",
        "UNLABELED_TEST",
        "REPLAY_ONLY_SOURCE",
        "SEALED_AUDIT"
      ]
    },
    "answer_visibility": {
      "enum": [
        "CHALLENGE_ONLY",
        "ANSWER_VISIBLE",
        "ANSWER_UNAVAILABLE",
        "SUCCESS_TRAJECTORY_VISIBLE",
        "ENVIRONMENT_SOURCE_AND_HIDDEN_STATE_VISIBLE"
      ]
    },
    "development_usage": {
      "enum": [
        "DISTILLATION_SOURCE",
        "AVAILABLE_TEACHER_NOT_CONSUMED",
        "REPLAY_HARNESS_ONLY",
        "SEALED_AUDIT_ONLY"
      ]
    },
    "contamination_class": {
      "enum": [
        "NONE",
        "PUBLIC_EVALUATION_INPUT_VISIBLE",
        "PUBLIC_EVALUATION_ANSWER_VISIBLE_NOT_CONSUMED",
        "PUBLIC_EVALUATION_SUCCESS_TRAJECTORY_CONSUMED",
        "UNLABELED_TEST_NO_ANSWER",
        "PRIVILEGED_ENVIRONMENT_IMPLEMENTATION"
      ]
    },
    "materialization_state": {
      "enum": [
        "REPOSITORY_TRACKED",
        "EXTERNAL_ARCHIVE_VERIFIED",
        "REFERENCED_NOT_LOCALLY_MATERIALIZED"
      ]
    },
    "source_code_access": {
      "enum": [
        "NOT_SOURCE_CODE",
        "REPLAY_HARNESS_ONLY"
      ]
    },
    "policy_weight_source": {
      "const": false
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/repositoryTreeSelector"
          },
          {
            "$ref": "#/$defs/repositoryFilesSelector"
          },
          {
            "$ref": "#/$defs/archiveMembersSelector"
          },
          {
            "$ref": "#/$defs/externalDatasetRowsSelector"
          }
        ]
      }
    },
    "digest_excluded_fields": {
      "const": [
        "content_digest"
      ]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^hds-source-profile:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repositoryTreeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_kind",
        "root",
        "expected_file_count",
        "expected_path_set_sha256",
        "archive_alias_distribution_id",
        "archive_alias_prefix"
      ],
      "properties": {
        "selector_kind": {
          "const": "REPOSITORY_TREE"
        },
        "root": {
          "$ref": "#/$defs/repositoryPath"
        },
        "expected_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "expected_path_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_alias_distribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_alias_prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "repositoryFilesSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_kind",
        "paths",
        "expected_file_count"
      ],
      "properties": {
        "selector_kind": {
          "const": "REPOSITORY_FILES"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "expected_file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "archiveMembersSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_kind",
        "distribution_id",
        "expected_distribution_sha256",
        "members"
      ],
      "properties": {
        "selector_kind": {
          "const": "ARCHIVE_MEMBERS"
        },
        "distribution_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_distribution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        }
      }
    },
    "externalDatasetRowsSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_kind",
        "source_manifest_path",
        "dataset_id",
        "dataset_repo_sha",
        "recording_field",
        "expected_selected_count",
        "expected_filename_set_sha256"
      ],
      "properties": {
        "selector_kind": {
          "const": "EXTERNAL_DATASET_MANIFEST_ROWS"
        },
        "source_manifest_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_repo_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recording_field": {
          "const": "recording_file"
        },
        "expected_selected_count": {
          "type": "integer",
          "minimum": 1
        },
        "expected_filename_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
