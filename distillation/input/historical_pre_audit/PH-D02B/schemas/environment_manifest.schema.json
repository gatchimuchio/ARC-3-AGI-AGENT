{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.arc3.invalid/schemas/environment_manifest.schema.json",
  "title": "PH-D01B EnvironmentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "environment_source",
    "runtime_wheels",
    "python",
    "os",
    "dependencies",
    "dependency_lock_digest",
    "seed",
    "reset_mode",
    "source_access_contract",
    "isolation_report_digest",
    "digest_excluded_fields",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "hds-environment-manifest-v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "manifest_version": {
      "const": 1
    },
    "environment_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_content_manifest_id",
        "source_content_digest",
        "source_count",
        "directory_merkle_root"
      ],
      "properties": {
        "source_content_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "source_content_digest": {
          "type": "string",
          "pattern": "^hds-source-content-manifest:[0-9a-f]{64}$"
        },
        "source_count": {
          "const": 50
        },
        "directory_merkle_root": {
          "type": "string",
          "pattern": "^hds-directory-merkle-v1:[0-9a-f]{64}$"
        }
      }
    },
    "runtime_wheels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/wheel"
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "architecture",
        "abi_flags",
        "soabi"
      ],
      "properties": {
        "implementation": {
          "const": "CPython"
        },
        "version": {
          "const": "3.12.13"
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "abi_flags": {
          "type": "string"
        },
        "soabi": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "version",
        "machine"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "dependency_lock_digest": {
      "type": "string",
      "pattern": "^hds-environment-dependency-lock:[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "reset_mode": {
      "const": "OFFLINE_FULL_RESET_PER_REPLAY"
    },
    "source_access_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_write_count",
        "source_mutation_count",
        "environment_source_consumer"
      ],
      "properties": {
        "mode": {
          "const": "READ_ONLY_HASH_AND_REPLAY_INTERFACE"
        },
        "source_write_count": {
          "const": 0
        },
        "source_mutation_count": {
          "const": 0
        },
        "environment_source_consumer": {
          "const": "REPLAY_HARNESS_ONLY"
        }
      }
    },
    "isolation_report_digest": {
      "type": "string",
      "pattern": "^hds-environment-isolation-report:[0-9a-f]{64}$"
    },
    "digest_excluded_fields": {
      "const": [
        "content_digest"
      ]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^hds-environment-manifest:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "filename",
        "archive_member",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "distribution": {
          "enum": [
            "arc-agi",
            "arcengine"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "pattern": "\\.whl$"
        },
        "archive_member": {
          "type": "string",
          "pattern": "\\.whl$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
