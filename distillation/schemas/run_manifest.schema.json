{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.arc3.invalid/schemas/run_manifest.schema.json",
  "title": "PH-D01B RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "input_profile_ids",
    "input_content_digests",
    "environment_manifest_digest",
    "working_directory",
    "command",
    "capture_tool_sha256",
    "started_at",
    "ended_at",
    "exit_code",
    "stdout_sha256",
    "stderr_sha256",
    "network_scope",
    "digest_excluded_fields",
    "run_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "hds-run-manifest-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "input_profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_content_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+:[0-9a-f]{64}$"
      }
    },
    "environment_manifest_digest": {
      "type": "string",
      "pattern": "^hds-environment-manifest:[0-9a-f]{64}$"
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capture_tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "network_scope": {
      "enum": [
        "NONE",
        "PINNED_HUGGINGFACE_DATASET_READ_ONLY"
      ]
    },
    "digest_excluded_fields": {
      "const": [
        "run_digest"
      ]
    },
    "run_digest": {
      "type": "string",
      "pattern": "^hds-run-manifest:[0-9a-f]{64}$"
    }
  }
}
