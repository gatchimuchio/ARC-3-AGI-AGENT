{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gatchimuchio/ARC-3-AGI-AGENT/schemas/open_term_record.schema.json",
  "title": "HDS OpenTermRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_digest",
    "digest_excluded_fields",
    "open_term_id",
    "phase_id",
    "question",
    "schema_version",
    "status"
  ],
  "properties": {
    "content_digest": {
      "pattern": "^hds-open-term-record:[0-9a-f]{64}$",
      "type": "string"
    },
    "digest_excluded_fields": {
      "const": [
        "content_digest",
        "open_term_id"
      ]
    },
    "open_term_id": {
      "minLength": 1,
      "type": "string"
    },
    "phase_id": {
      "pattern": "^PH-[A-Z0-9-]+$",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "hds-open-term-record-v1"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "SUSPEND"
      ]
    }
  }
}
