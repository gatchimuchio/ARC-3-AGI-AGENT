from collections import defaultdict
data=defaultdict(set); amb=0
for idx,t in enumerate(transitions):
    a=t.action
    if a not in ('UP','DOWN','LEFT','RIGHT'): continue
    b=sorted(cells(t.before_frame)); af=sorted(cells(t.after_frame))
    if len(b)!=2 or len(af)!=2: continue
    import itertools
    opts=[]
    for perm in itertools.permutations(range(2)):
        d=sum(abs(b[k][0]-af[perm[k]][0])+abs(b[k][1]-af[perm[k]][1]) for k in range(2))
        opts.append((d,perm))
    opts.sort()
    if len(opts)>1 and opts[0][0]==opts[1][0]: amb+=1; continue
    d,perm=opts[0]
    for k in range(2):
        data[(a,b[k])].add(af[perm[k]])
bad=[(k,v) for k,v in data.items() if len(v)>1]
print('ambiguous',amb,'inconsistent rules',len(bad))
for k,v in bad[:12]: print(k,v)
# summarize: for each action, how does delta depend on j side?
