def cmap(fr,r0=6,c0=2,n=14,s=4):
    L=fr.ascii.split('\n'); out=[]
    for r in range(n):
        row=''
        for c in range(n):
            d={}
            for dr in range(s):
                for dc in range(s):
                    ch=L[r0+r*s+dr][c0+c*s+dc]; d[ch]=d.get(ch,0)+1
            tot=s*s; mx=max(d,key=d.get)
            if d.get('S',0)>=tot-2: row+='S'
            elif d.get('p',0)>=tot-2: row+='p'
            elif d.get('N',0)>=tot-2: row+='N'
            elif d.get('O',0)>=tot-2: row+='O'
            elif d.get('M',0)>=tot-2: row+='M'
            elif d.get('P',0)>=tot-2: row+='P'
            elif d.get('B',0)==tot: row+='#'
            else: row+='?'
        out.append(row)
    return out
