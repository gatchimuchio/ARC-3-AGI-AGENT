def cmap2(fr,r0=6,c0=2,nr=14,nc=15,s=4):
    L=fr.ascii.split('\n'); out=[]
    for r in range(nr):
        row=''
        for c in range(nc):
            d={}
            for dr in range(s):
                for dc in range(s):
                    rr=r0+r*s+dr; cc=c0+c*s+dc
                    if rr>=64 or cc>=64: continue
                    ch=L[rr][cc]; d[ch]=d.get(ch,0)+1
            tot=sum(d.values()); mx=max(d,key=d.get)
            if d.get('S',0)>=tot-2: row+='S'
            elif d.get('p',0)>=tot-2: row+='p'
            elif d.get('N',0)>=tot-2: row+='N'
            elif d.get('O',0)>=tot-2: row+='O'
            elif d.get('B',0)==tot: row+='#'
            elif d.get('M',0)+d.get('P',0)>=tot-2: row+='.'
            else: row+='?'
        out.append(row)
    return out
C=cmap2(current_frame)
