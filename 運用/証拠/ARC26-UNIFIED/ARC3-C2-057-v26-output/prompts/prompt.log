def gmap(fr,o=9,p=5,n=9):
    L=fr.ascii.split('\n')
    out=[]
    for r in range(n):
        row=''
        for c in range(n):
            d={}
            for dr in range(p):
                for dc in range(p):
                    ch=L[o+r*p+dr][o+c*p+dc]; d[ch]=d.get(ch,0)+1
            tot=p*p; mx=max(d,key=d.get)
            if d.get('S',0)>=tot-2: row+='S'
            elif d.get('b',0)>0: row+='K'
            elif d.get('R',0)>0 and d.get('B',0)>0: row+='R'
            elif d.get('B',0)==tot: row+='#'
            elif d.get('Y',0)>tot//2: row+='y'
            elif d.get('p',0)>tot//2: row+='p'
            else: row+='?'
        out.append(row)
    return out
M=gmap(current_frame)
