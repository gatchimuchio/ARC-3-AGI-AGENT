def f6(r,c): return 0<=r<15 and 0<=c<15 and M6[r][c]=='B'
def nxt(st,m):
    dr1,dc1,dr2,dc2=MV[m]; (r1,c1),(r2,c2)=st
    n1=(r1+dr1,c1+dc1); n2=(r2+dr2,c2+dc2)
    if n1==(r2,c2) or n2==(r1,c1): return None
