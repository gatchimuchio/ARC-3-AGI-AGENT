from collections import deque
M4=['.............','.............','...B....BBBBB..','..BBB.BBB...B..','..B.B.B...B.B..','..B.B.B.BBBBB..','..B.BBB.B......','..B.....BBBBB..','.BBBBBB....BB..','......B.BB.B...','...BBBB.BBBBB..','...BBBB.BBBBB..','...BBBB.BBBBB..','.............','.............']
MV={'UP':(-1,0,-1,0),'DOWN':(1,0,1,0),'LEFT':(0,-1,0,1),'RIGHT':(0,1,0,-1)}
def fl(r,c,M4=M4): return 0<=r<15 and 0<=c<15 and M4[r][c]=='B'
def stepn(st,m):
    dr1,dc1,dr2,dc2=MV[m]; (r1,c1),(r2,c2)=st
    n1=(r1+dr1,c1+dc1); n2=(r2+dr2,c2+dc2)
    coll=(n1==(r2,c2) or n2==(r1,c1))
    p1=(r1,c1) if not fl(*n1) else n1; p2=(r2,c2) if not fl(*n2) else n2
    return (p1,p2),coll
start=((10,4),(7,10))
seen={start}; q=deque([(start,[])]) ; path=None
while q and path is None:
    st,pth=q.popleft()
    for m in ['UP','DOWN','LEFT','RIGHT']:
        ns,coll=stepn(st,m)
        if coll: path=pth+[m]; break
        if ns in seen or ns==st: continue
        seen.add(ns); q.append((ns,pth+[m]))
print('merge path',len(path),path)
st=start; last=None
for i,m in enumerate(path):
