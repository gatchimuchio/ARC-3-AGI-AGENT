def exec3d(seq, start=None):
    fl,tok=grid3d(); comp=comps3(fl)
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    if start is None:
        bs=find_all()[0]
        rooms=sorted({comp.get(p) for p in bs})
        left_room=min(rooms,key=lambda c: min(q[1] for q in fl if comp.get(q)==c))
        cur=tuple([ [p for p in bs if comp.get(p)==c][0] for c in (left_room,[r for r in rooms if r!=left_room][0]) ])
    else: cur=tuple(start)
    leftc=comp.get(cur[0]); log=[('start',cur)]
    for k,m in enumerate(seq):
        d=D[m]; pr=[]
        for p,mir in ((cur[0],False),(cur[1],True)):
            dd=(d[0],-d[1]) if mir else d
            q=(p[0]+dd[0],p[1]+dd[1])
            pr.append(q if q in fl else p)
        for attempt in range(3):
            try:
                r=action([m]); break
            except Exception as e:
                if attempt==2: raise
                r={'no_op':True}
        bs2=find_all()[0]
        got=tuple([ [p for p in bs2 if comp.get(p)==leftc][0], [p for p in bs2 if comp.get(p)!=leftc][0] ])
        st='ok' if got==tuple(pr) else 'MISMATCH'
        log.append((k,m,pr,got,st))
        if st!='ok' or r.get('level_completed') or r.get('game_over') or r.get('done'):
            return {'log':log,'pos':got,'lc':r.get('level_completed'),'go':r.get('game_over'),'done':r.get('done')}
        cur=got
    return {'log':log,'pos':cur,'lc':False,'go':False,'done':False}
out=exec3d(['UP','RIGHT','RIGHT','RIGHT','RIGHT','UP','UP','UP','LEFT','LEFT'], start=((10,4),(7,11)))
