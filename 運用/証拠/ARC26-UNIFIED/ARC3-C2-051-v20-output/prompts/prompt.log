def plan3(goal_pred, start, forbid_noop=True):
    from collections import deque
    fl,tok=grid3d()
    D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    def nx(p,m,mir):
        d=D[m]
        if mir: d=(d[0],-d[1])
        q=(p[0]+d[0],p[1]+d[1])
        return q if q in fl else p
    seen={start:[]}; q=deque([start]); res=None
    while q and not res:
        s=q.popleft(); path=seen[s]
        for m in D:
            ns=(nx(s[0],m,False),nx(s[1],m,True))
            if ns==s and forbid_noop: continue
            if ns in seen: continue
            np_=path+[m]
            if goal_pred(ns): return ns,np_
            seen[ns]=np_; q.append(ns)
    return None
def safe_act(m):
    try:
        return action([m])
    except BaseException as e:
        return {'no_op':True,'stale':type(e).__name__}
def exec3e(seq, start):
