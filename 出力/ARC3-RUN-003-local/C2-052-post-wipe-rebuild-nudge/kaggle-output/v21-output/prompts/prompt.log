def bmap(fr):
    G=[list(x) for x in fr.ascii.split('\n')]
    out={}
    for i in range(15):
        for j in range(15):
            cs=set(G[2+4*i+a][2+4*j+b] for a in range(4) for b in range(4))
            if cs=={'B'}: continue
            out[(i,j)]=max(cs,key=lambda c:sum(G[2+4*i+a][2+4*j+b2]==c for a in range(4) for b2 in range(4)))
    return out
