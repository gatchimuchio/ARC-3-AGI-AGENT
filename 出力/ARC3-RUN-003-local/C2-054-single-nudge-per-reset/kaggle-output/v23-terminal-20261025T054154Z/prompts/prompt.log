occ=set()
for (r,c) in marks:
    for i in range(2):
        for j in range(2): occ.add((r+i,c+j))
B=4
def cells(r,c): return [(r+i,c+j) for i in range(B) for j in range(B)]
def ok(r,c,extra=frozenset()):
    if r<0 or c<0 or r+B>64 or c+B>64: return False
    cs=cells(r,c)
    return all(walk[x][y] for x,y in cs) and not (set(cs)&occ)
MOV={'U':((-4,0),(-4,0)),'D':((4,0),(4,0)),'L':((0,-4),(0,4)),'R':((0,4),(0,-4))}
def trans(s,k):
    L,R=s; mvL,mvR=MOV[k]; out=[]
    for p,mv,op in ((L,mvL,R),(R,mvR,L)):
        q=(p[0]+mv[0],p[1]+mv[1])
        if not ok(*q,frozenset(cells(*op))): out.append(p)
        else: out.append(q)
    if tuple(out)==s: return None
    return tuple(out)
start=((14,10),(38,34)); goal=((10,14),(14,50))
seen={start}; q=collections.deque([(start,'')]); found=None
