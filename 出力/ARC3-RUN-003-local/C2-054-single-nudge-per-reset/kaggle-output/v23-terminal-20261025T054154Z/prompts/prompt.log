def snap2(f):
    L=f.ascii.split('\n')
    out={}
    for col in 'bSYw':
        pts=[(r,c) for r in range(64) for c in range(64) if L[r][c]==col]
        for comp in comps(pts):
            out.setdefault(col,[]).append((min(p[0] for p in comp),min(p[1] for p in comp),len(comp)))
    return {k:sorted(v) for k,v in out.items()}
