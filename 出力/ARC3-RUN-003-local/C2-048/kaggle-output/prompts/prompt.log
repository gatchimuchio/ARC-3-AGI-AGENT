DIRS={'UP':(-4,0),'DOWN':(4,0),'LEFT':(0,-4),'RIGHT':(0,4)}
P,M=mk_model2(current_frame.ascii)
mk={'A':(11,15),'B':(19,43),'C':(31,51)}
mc=set()
for v in mk.values(): mc|=set(c2(v))
def pm(p,act):
    d=DIRS[act]; n=(p[0]+d[0],p[1]+d[1])
    return n if (n in P and not (set(c4(n)) & mc)) else p
start=((22,10),(34,50))
