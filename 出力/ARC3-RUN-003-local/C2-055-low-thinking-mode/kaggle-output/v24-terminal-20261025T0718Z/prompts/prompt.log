from collections import deque
rows=current_frame.ascii.split('\n')
W=[[rows[r][c]=='B' for c in range(64)] for r in range(64)]
for c in range(64): W[0][c]=True; W[63][c]=True
P=[[0]*65 for _ in range(65)]
for r in range(64):
    s=0
    for c in range(64):
        s+=1 if W[r][c] else 0
        P[r+1][c+1]=P[r][c+1]+s
free=[[False]*64 for _ in range(64)]
for r in range(64):
    for c in range(64):
        if r+5<=64 and c+5<=64:
            free[r][c]=(P[r+5][c+5]-P[r][c+5]-P[r+5][c]+P[r][c])==0 and r>=1
MVM={'UP':(-1,0,-1,0),'DOWN':(1,0,1,0),'LEFT':(0,-1,0,-1),'RIGHT':(0,1,0,1)}
def step(s,m):
    a,b,c,d=MVM[m]
    def one(p,dr,dc):
        r,cc=p; nr,nc=r+dr,cc+dc
        if nr<1 or nc<0 or nr+5>64 or nc+5>64: return (r,cc)
        return (nr,nc) if free[nr][nc] else (r,cc)
    return (one(s[0],a,b),one(s[1],c,d))
start=spos(current_frame)
prev={start:None}; pq=deque([start]); goal=None
while pq:
    s=pq.popleft()
    if s[0]==(9,44) and s[1][0]==14: goal=s; break
    for m in MVM:
        n=step(s,m)
        if n==s or n in prev: continue
        prev[n]=(s,m); pq.append(n)
if goal:
    p=[];s=goal
    while prev[s]: q,m=prev[s]; p.append(m); s=q
    p.reverse(); print("goal",goal,len(p),p)
    cur=start; res=None
    for i,m in enumerate(p):
        pred=step(cur,m); action([m]); act=spos(current_frame); r=last_action_call_result
        if r.get('level_completed') or r.get('run_complete'): print("WON at",i+1,m); res='won'; break
        if act!=pred: print("DIVERGE",i+1,m,"pred",pred,"act",act); res='div'; break
        cur=act
    if res is None: print("executed to",cur)
else: print("unreachable")
