from collections import deque
r=current_frame.ascii.split('\n')
W=[[r[i][j]=='B' for j in range(64)] for i in range(64)]
for j in range(64): W[0][j]=True; W[63][j]=True
P=[[0]*65 for _ in range(65)]
for i in range(64):
    s=0
    for j in range(64):
        s+=1 if W[i][j] else 0
        P[i+1][j+1]=P[i][j+1]+s
free=[[False]*64 for _ in range(64)]
for i in range(64):
    for j in range(64):
        if i+5<=64 and j+5<=64:
            free[i][j]=(P[i+5][j+5]-P[i][j+5]-P[i+5][j]+P[i][j])==0 and i>=1
MVM={'UP':(-1,0,-1,0),'DOWN':(1,0,1,0),'LEFT':(0,-1,0,-1),'RIGHT':(0,1,0,1)}
def step(s,m):
    a,b,c,d=MVM[m]
    def one(p,dr,dc):
        i,j=p; ni,nj=i+dr,j+dc
        if ni<1 or nj<0 or ni+5>64 or nj+5>64: return (i,j)
        return (ni,nj) if free[ni][nj] else (i,j)
    return (one(s[0],a,b),one(s[1],c,d))
start=spos(current_frame)
print("start",start)
# targets: each 5x5 box's top-left
tg=[(49,19),(49,39)]
# BFS over full state, goal = either block covering a target zone (rows 49..53)
prev={start:None}; pq=deque([start]); goal=None
def isgoal(s):
    a,b=s
    return (49<=a[0]<=53) or (49<=b[0]<=53)
while pq:
    s=pq.popleft()
    if isgoal(s): goal=s; break
    for m in MVM:
        n=step(s,m)
        if n==s or n in prev: continue
        prev[n]=(s,m); pq.append(n)
if goal:
    p=[];s=goal
    while prev[s]: q,m=prev[s]; p.append(m); s=q
    p.reverse(); print("goal",goal,"len",len(p))
    # compact
    comp=[]
    for m in p:
        if comp and comp[-1][0]==m: comp[-1][1]+=1
        else: comp.append([m,1])
    print(comp)
else:
    print("no goal reachable; reachable states:", len(prev))
    # print which rows are reachable for each block
    ra=sorted({s[0][0] for s in prev}); rb=sorted({s[1][0] for s in prev})
    print("rows A", ra[:5], ra[-5:], "rows B", rb[:5], rb[-5:])
