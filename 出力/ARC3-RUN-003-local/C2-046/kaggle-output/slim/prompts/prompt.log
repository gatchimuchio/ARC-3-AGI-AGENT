def gridL5(fr,o=6,k=4,n=13):
    a=fr.ascii.split('\n'); out=[]
    for i in range(n):
        row=''
        for j in range(n):
            blk=[a[o+k*i+di][o+k*j+dj] for di in range(k) for dj in range(k)]
            cnt={}
            for c in blk: cnt[c]=cnt.get(c,0)+1
            top=max(cnt,key=lambda c:cnt[c])
            if top in ('M','P'): row+='#'
            elif top=='B': row+='.'
            else: row+=top
        out.append(row)
    return out
