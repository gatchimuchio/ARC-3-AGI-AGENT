def grid5(fr,o=9,k=5,n=9):
    a=fr.ascii.split('\n'); out=[]
    for i in range(n):
        row=''
        for j in range(n):
            blk=[a[o+k*i+di][o+k*j+dj] for di in range(k) for dj in range(k)]
            cnt={}
            for c in blk: cnt[c]=cnt.get(c,0)+1
            if cnt.get('S',0)>0: row+='S'
            elif cnt.get('b',0)>0 or cnt.get('Y',0)>0 and False: row+='b'
            elif cnt.get('R',0)>0: row+='X'
            elif cnt.get('B',0)>0 and cnt.get('R',0)==0 and max(cnt,key=lambda c:cnt[c])=='B': row+='X'
            elif cnt.get('Y',0)>0 or cnt.get('p',0)>0: row+='#'
            else: row+='.'
        out.append(row)
    return out
