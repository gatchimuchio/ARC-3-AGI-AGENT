BASE=['XXX###XXX','...###...','...###...','...XXX...','.........','...XXX...','...###...','...###...','XXX###XXX']
def bfs_len(src,dst,cells):
    import collections
    if src==dst: return 0,[]
    q=collections.deque([src]); prev={src:None}
    while q:
        c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            n=(c[0]+dr,c[1]+dc)
            if n in cells and n not in prev:
                prev[n]=c
                if n==dst:
                    p=[]; cur=n
                    while cur!=src: p.append(cur); cur=prev[cur]
                    return len(p),p[::-1]
                q.append(n)
    return None,None
floor=set((i,j) for i in range(9) for j in range(9) if BASE[i][j]=='.')
blk=(4,4)
def merge_bfs(G,start):
    import collections
    MOV={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    fl=set((i,j) for i in range(9) for j in range(9) if G[i][j]=='.')
    def mv(c,d):
        n=(c[0]+d[0],c[1]+d[1]); return n if n in fl else c
    q=collections.deque([(start,[])]); seen={start}
    while q:
        s,p=q.popleft(); L,R=s
        for name,d in MOV.items():
            nL=mv(L,d); nR=mv(R,(d[0],-d[1]))
            if nL==nR or (nL==R and nR==L): return p+[name]
            ns=(nL,nR)
            if ns not in seen and ns!=s:
                seen.add(ns); q.append((ns,p+[name]))
    return None
start=((4,1),(2,7))
best=[]
for p in sorted(floor):
    if p==blk: continue
    db,pth=bfs_len(blk,p,floor-{blk})
    if db is None: continue
    G=[list(r) for r in BASE]
    G[p[0]][p[1]]='#'
    G=  [''.join(r) for r in G]
    m=merge_bfs(G,start)
    if m is None: continue
    best.append((1+db+1+len(m),p,db,len(m)))
best.sort()
for b in best[:8]: print(b)
