def gridA(fr,o=6,oh=2,k=4,nr=13,nc=15):
    a=fr.ascii.split('\n'); out=[]
    for i in range(nr):
        row=''
        for j in range(nc):
            blk=[a[o+k*i+di][oh+k*j+dj] for di in range(k) for dj in range(k)]
            cnt={}
            for c in blk: cnt[c]=cnt.get(c,0)+1
            top=max(cnt,key=lambda c:cnt[c])
            row+= '#' if top in ('M','P') else ('.' if top=='B' else top)
        out.append(row)
    return out
