FREE=frozenset(c for c,v in CELL.items() if v=='free')
D={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
M={'UP':'UP','DOWN':'DOWN','LEFT':'RIGHT','RIGHT':'LEFT'}
def joint(A,B,walls):
    F=FREE
    if A==B: return []
    W=set(walls); prev={(A,B):None}; q=collections.deque([(A,B)])
    while q:
        a,b=q.popleft()
        for d in ('UP','DOWN','LEFT','RIGHT'):
            dr,dc=D[d]; r,c=a; ta=(r+dr,c+dc)
            dr,dc=D[M[d]]; r,c=b; tb=(r+dr,c+dc)
            na = ta if (ta in F and ta not in W) else a
            nb = tb if (tb in F and tb not in W) else b
            if na==b and nb==a: continue
            if na==b and na!=nb: continue
            if nb==a and na!=nb: continue
            ns=(na,nb)
            if ns in prev: continue
            prev[ns]=((a,b),d)
            if na==nb:
                out=[];cur=ns
                while prev[cur] is not None: out.append(prev[cur][1]);cur=prev[cur][0]
                return out[::-1]
            q.append(ns)
    return None
