def tokpos(g):
    cells=[(r,c) for r in range(64) for c in range(64) if g[r][c] in 'bY']
    groups={}
    for r,c in cells: groups.setdefault((r//2,c//2),(0,0))
    # cluster by proximity
    pts=sorted(set(cells)); out=[]
    used=set()
    for p in pts:
        if p in used: continue
        cl=[p]; used.add(p)
        for q in pts:
            if q in used: continue
            if any(abs(q[0]-x[0])+abs(q[1]-x[1])<=2 for x in cl): cl.append(q); used.add(q)
        out.append((min(x[0] for x in cl),min(x[1] for x in cl),len(cl)))
    return sorted(out)
