def solve2(GRID, start, goal='same', forbid='R', maxn=200000):
    from collections import deque
    n=len(GRID); m=len(GRID[0])
    W=frozenset((i,j) for i in range(n) for j in range(m) if GRID[i][j] in 'BS')
    DL={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    DR={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,1),'RIGHT':(0,-1)}
    def mv(p,d,o):
        q=(p[0]+d[0],p[1]+d[1])
        if q not in W or q==o: return p
        return q
    seen={start}; par={start:None}; dq=deque([start]); g=None
    while dq:
        s=dq.popleft()
        if goal=='same' and s[0]==s[1]: g=s; break
        if goal=='adj' and abs(s[0][0]-s[1][0])+abs(s[0][1]-s[1][1])==1: g=s; break
        for k in ['UP','DOWN','LEFT','RIGHT']:
            ns=(mv(s[0],DL[k],s[1]), mv(s[1],DR[k],s[0]))
            if ns not in seen: seen.add(ns); par[ns]=(k,s); dq.append(ns)
    if g is None: return None,None,len(seen)
    path=[]; s=g
    while par[s] is not None:
        k,s2=par[s]; path.append(k); s=s2
    path.reverse()
    return path, g, len(seen)
GRID=["BBBBBBMBBBBBB","BBBSBBMBBSBBB","BBBBBBMBBBBBB","BBMMMMMppppBB","BBMBMMMppppBB","BBBBBRMBBBBBB","BBBBBRMBBBBBB","BBBBBRMBBBBBB","RRRBRRMBRRRRR","BBBBBBMBBBBBB","BBBBBBBBBBBBB","BBBBBBBBBBBBB","RRRRRRRRRRRRR"]
p,g,n=solve2(GRID, ((1,3),(1,9)))
print('same goal', g, 'len', len(p) if p else None, 'states', n)
print(p)
