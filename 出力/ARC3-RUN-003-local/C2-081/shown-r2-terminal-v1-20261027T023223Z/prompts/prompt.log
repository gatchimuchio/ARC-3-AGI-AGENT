        flag=''.join('X' if q in FATAL else ('.' if q in SAFE else '#') for q in (tl,tr))
        if tl not in SAFE or tl==r: tl=l
        if tr not in SAFE or tr==l: tr=r
        s=(tl,tr); out.append((d,s,flag))
    return out
