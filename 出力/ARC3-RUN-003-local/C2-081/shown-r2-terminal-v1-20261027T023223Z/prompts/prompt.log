def solve3(GRID, start):
    from collections import deque
    n=len(GRID); m=len(GRID[0])
    SAFE=set((i,j) for i in range(n) for j in range(m) if GRID[i][j] in 'BS')
    FATAL=set((i,j) for i in range(n) for j in range(m) if GRID[i][j]=='R')
    DL={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    DR={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,1),'RIGHT':(0,-1)}
    def mv(p,d,o):
        q=(p[0]+d[0],p[1]+d[1])
        if q in FATAL: return None
        if q not in SAFE or q==o: return p
        return q
    seen={start}; par={start:None}; dq=deque([start]); g=None
    while dq:
        s=dq.popleft()
        if s[0]==s[1]: g=s; break
        for k in ['UP','DOWN','LEFT','RIGHT']:
            tl=mv(s[0],DL[k],s[1]); tr=mv(s[1],DR[k],s[0])
            if tl is None or tr is None: continue
            if tl==tr and tl not in SAFE: continue
            ns=(tl,tr)
            if ns not in seen: seen.add(ns); par[ns]=(k,s); dq.append(ns)
    if g is None: return None,None,len(seen)
    path=[]; s=g
    while par[s] is not None:
        k,s2=par[s]; path.append(k); s=s2
    path.reverse(); return path,g,len(seen)
