def make_sim(MASK):
    W = frozenset((i,j) for i in range(len(MASK)) for j in range(len(MASK[0])) if MASK[i][j] in 'WA')
    DL = {'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    DR = {'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,1),'RIGHT':(0,-1)}
    def step(s,d):
        l,r=s
        tl=(l[0]+DL[d][0], l[1]+DL[d][1]); tr=(r[0]+DR[d][0], r[1]+DR[d][1])
        if tl not in W: tl=l
        if tr not in W: tr=r
        if tl==r: tl=l
        if tr==l: tr=r
        return (tl,tr)
    return step,W
def bfs_from(MASK, start, goal):
    step,W = make_sim(MASK)
    from collections import deque
    seen={start}; par={start:None}; dq=deque([start])
    while dq:
        s=dq.popleft()
        if goal(s):
            path=[]
            while par[s] is not None:
                d,s2=par[s]; path.append(d); s=s2
            return list(reversed(path)), s
        for d in ['UP','DOWN','LEFT','RIGHT']:
            ns=step(s,d)
            if ns not in seen: seen.add(ns); par[ns]=(d,s); dq.append(ns)
    return None,None
