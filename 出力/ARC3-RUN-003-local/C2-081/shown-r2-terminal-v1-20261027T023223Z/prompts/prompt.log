W = {(i,j) for i in range(10) for j in range(10) if MASK[i][j] in 'WA'}
L0=(7,2); R0=(7,6)
DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
def step(p,d,block=None):
    di,dj=DIRS[d]; q=(p[0]+di,p[1]+dj)
    if q in W and q!=block: return q
    return p
from collections import deque
def bfs(goal_fn, allow_swap=True):
    start=(L0,R0); seen={start}; par={start:None}
    dq=deque([start])
    while dq:
        s=dq.popleft()
        if goal_fn(s): 
            path=[]
            while par[s]: 
                a,s2=par[s]; path.append(a); s=s2
            return list(reversed(path)), s
        for d in 'UDLR':
            l,r=s
            # simultaneous: compute targets, block by other's target (allow crossing swap)
            tl = step(l,d,r); tr = step(r,d,l)
            ns=(tl,tr)
            if ns not in seen:
                seen[ns]=1; par[ns]=(d,s); dq.append(ns)
    return None,None
adj = lambda s: abs(s[0][0]-s[1][0])+abs(s[0][1]-s[1][1])==1
same = lambda s: s[0]==s[1]
