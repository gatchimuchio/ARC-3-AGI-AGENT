def plan(MASK, L0, R0, goal_fn, maxdepth=30):
    W = {(i,j) for i in range(len(MASK)) for j in range(len(MASK[0])) if MASK[i][j] in 'WA'}
    DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    def st(p,other,d):
        di,dj=DIRS[d]; q=(p[0]+di,p[1]+dj)
        if q in W and q!=other: return q
        return p
    from collections import deque
    start=(L0,R0); seen={start}; par={start:None}; dq=deque([start])
    while dq:
        s=dq.popleft()
        if goal_fn(s):
            path=[]
            while par[s] is not None:
                d,s2=par[s]; path.append(d); s=s2
            return list(reversed(path)), s, seen
        for d in 'UDLR':
            l,r=s
            ns=(st(l,r,d), st(r,l,d))
            if ns not in seen:
                seen.add(ns); par[ns]=(d,s); dq.append(ns)
    return None, None, seen
