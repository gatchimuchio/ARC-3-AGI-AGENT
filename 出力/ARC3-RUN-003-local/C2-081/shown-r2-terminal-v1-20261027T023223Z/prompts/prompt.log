def trace3(GRID,start,path):
    n=len(GRID);m=len(GRID[0])
    SAFE={(i,j) for i in range(n) for j in range(m) if GRID[i][j] in 'BS'}
    FATAL={(i,j) for i in range(n) for j in range(m) if GRID[i][j]=='R'}
    DL={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
    DR={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,1),'RIGHT':(0,-1)}
    s=start; out=[]
    for d in path:
        l,r=s
