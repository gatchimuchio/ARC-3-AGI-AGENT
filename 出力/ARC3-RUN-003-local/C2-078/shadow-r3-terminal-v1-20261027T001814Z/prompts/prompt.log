def solve(hazard_ok, goal):
    P=[[ch in 'BS' or (hazard_ok and ch=='R') for ch in row] for row in M13]
    def mv(p,d):
        nr,nc=p[0]+d[0],p[1]+d[1]
        return (nr,nc) if 0<=nr<13 and 0<=nc<13 and P[nr][nc] else p
    start=((0,4),(0,8))
    q=deque([start]); prev={start:None}
    while q:
        s=q.popleft()
        if goal(s):
            path=[];x=s
            while prev[x] is not None:
                x,m=prev[x]; path.append(m)
            path.reverse(); return path
        for m in MOV:
            ns=(mv(s[0],MOV[m]),mv(s[1],MIRR[m]))
            if ns not in prev: prev[ns]=(s,m); q.append(ns)
    return None
