M13 = ["BBBBBBMBBBBBB","BBBBBBMBBBBBB","BBBBBBMBBBBBB","BBMMMMMppppBB","BBMBMMMppppBB","BBBBBRMBBBBBB","BBBBBRMBBBBBB","BBBBBRMBBBBBB","RRRBRRMBRRRRR","BBBBBBMBBBBBB","BBBBBBBBBBBBB","BBBBBBBBBBBBB","RRRRRRRRRRRRR"]
