def exec_plan(plan, verbose=True):
    """Execute plan on current level (4px blocks origin 6,13x13). Verifies model each step."""
    MIR={'U':'U','D':'D','L':'R','R':'L'}
    DEL={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
