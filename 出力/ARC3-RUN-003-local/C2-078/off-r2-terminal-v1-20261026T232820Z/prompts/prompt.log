def analyze(a, org=6, bs=4, n=13):
    from collections import Counter
    G=[]; info=[]
    for br in range(n):
        row=''
        for bc in range(n):
            blk=[a[org+bs*br+r][org+bs*bc+c] for r in range(bs) for c in range(bs)]
            cnt=Counter(blk)
            nr=cnt.get('R',0); nb=cnt.get('B',0); ns=cnt.get('S',0)
            bg=bs*bs-nr-nb-ns
            if nr>0 and nb==0 and ns==0 and bg==0: row+='X'      # solid checker
            elif nr>0: row+='x'                                   # partial checker (mixed with black/square)
            elif ns>0: row+='@'
            elif nb==bs*bs: row+='.'
            elif bg==bs*bs: row+='#'
            else: row+='-'                                        # mixed wall
        G.append(row)
    return G
