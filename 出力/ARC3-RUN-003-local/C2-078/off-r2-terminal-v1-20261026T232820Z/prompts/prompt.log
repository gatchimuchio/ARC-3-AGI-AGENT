        ok = (pred is not None and cur==pred)
        log.append((d,s,pred,cur,'OK' if ok else 'DIFF', r.get('level_completed'), r.get('game_over')))
        if verbose: print(d,s,pred,cur,'OK' if ok else 'DIFF', 'WIN' if r.get('level_completed') else ('DEAD' if r.get('game_over') else ''))
        s=cur
        if r.get('level_completed') or r.get('game_over') or not ok: break
