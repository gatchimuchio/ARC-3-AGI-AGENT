def sim_plan(plan, G):
    MIR={'U':'U','D':'D','L':'R','R':'L'}; DEL={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    n=len(G)
    def kind(p):
        if not (0<=p[0]<n and 0<=p[1]<n): return '#'
        return G[p[0]][p[1]]
    def nxt(s,d):
        nl,nr=s; fatal=False
        for i,d2 in ((0,d),(1,MIR[d])):
            dr,dc=DEL[d2]; q=(s[i][0]+dr,s[i][1]+dc); k=kind(q)
            if k=='#': continue
            if k in 'xX': fatal=True
            if i==0: nl=q
            else: nr=q
        return (nl,nr),fatal
    start=tuple((r,c) for r in range(n) for c in range(n) if G[r][c]=='@')
    s=start; traj=[s]
    for d in plan:
        ns,f=nxt(s,d)
        if f: return s,traj,'FATAL at '+d
        if ns==s: return s,traj,'NOOP at '+d
        s=ns; traj.append(s)
    return s,traj,'done'
