def cls_grid(a, org=6, bs=4, n=13):
    from collections import Counter
    bgcols={a[2][2], a[2][61], a[61][2], a[61][61]}
    G=[]
    for br in range(n):
        row=''
        for bc in range(n):
            blk=[a[org+bs*br+r][org+bs*bc+c] for r in range(bs) for c in range(bs)]
            cnt=Counter(blk); tot=bs*bs
            nbg=sum(v for k,v in cnt.items() if k in bgcols)
            nb=cnt.get('B',0); ns=cnt.get('S',0); nv=cnt.get('b',0)
            other=tot-nbg-nb-ns-nv
            if ns>0: row+='@'
            elif nv>0: row+='b'
            elif nbg==tot: row+='#'
            elif nbg>0: row+='-'
            elif other>0: row+='x'
            elif nb==tot: row+='.'
            else: row+='?'
        G.append(row)
    return G
