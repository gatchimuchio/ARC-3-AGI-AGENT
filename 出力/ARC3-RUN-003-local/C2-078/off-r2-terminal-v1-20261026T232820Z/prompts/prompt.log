def exec2(plan, G=None, verbose=True):
    """Execute plan with model verification (mirrored controls, walls block, checkers fatal)."""
    MIR={'U':'U','D':'D','L':'R','R':'L'}; DEL={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
    NAME={'U':'UP','D':'DOWN','L':'LEFT','R':'RIGHT'}
    if G is None: G=analyze(current_frame.ascii.split('\n'))
    n=len(G)
    def kind(p):
        if not (0<=p[0]<n and 0<=p[1]<n): return '#'
        return G[p[0]][p[1]]
    def nxt(s,d):
        nl,nr=s; fatal=False
        for i,d2 in ((0,d),(1,MIR[d])):
            dr,dc=DEL[d2]; q=(s[i][0]+dr,s[i][1]+dc); k=kind(q)
            if k=='#': continue
            if k in 'xX': fatal=True
            if i==0: nl=q
            else: nr=q
        return (nl,nr),fatal
    def cur_sq():
        g=analyze(current_frame.ascii.split('\n'))
        return tuple((r,c) for r in range(n) for c in range(n) if g[r][c]=='@')
    s=cur_sq(); msgs=[]
    for d in plan:
        pred,f=nxt(s,d)
        r=action([NAME[d]])
        cur=cur_sq()
        win=r.get('level_completed'); dead=r.get('game_over')
        ok = (not f) and cur==pred
        msgs.append((d,s,pred,cur,'OK' if ok else 'DIFF', 'WIN' if win else '', 'DEAD' if dead else ''))
        if verbose: print(msgs[-1])
        s=cur
        if win or dead or not ok: break
    return msgs
