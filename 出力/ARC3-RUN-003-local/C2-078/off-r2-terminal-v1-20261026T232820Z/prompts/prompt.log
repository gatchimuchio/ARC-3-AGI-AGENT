a=current_frame.ascii.split('\n')
def build2(a, org=6, bs=4, n=13):
    G=[]
    for br in range(n):
        row=''
        for bc in range(n):
            blk=[a[org+bs*br+r][org+bs*bc+c] for r in range(bs) for c in range(bs)]
            from collections import Counter
            cnt=Counter(blk)
            nb=cnt.get('B',0); ns=cnt.get('S',0); nr=cnt.get('R',0)
            tot=bs*bs
            if ns>=tot*0.5: row+='@'
            elif nr>=tot*0.3: row+='x' if nb>0 else 'X'
            elif nb==tot: row+='.'
            else: row+='#'
        G.append(row)
    return G
