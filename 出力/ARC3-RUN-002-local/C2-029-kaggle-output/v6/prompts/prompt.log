ROWS = ("..BBBBBB.",".BBB.BBBB","BBB...BBB","BB.....BB",".B......B",".B......B","BBB....BB","BBBB.BBBB","BBBB.BBBB","BBBB.BBB.")
CONT=frozenset((i,j) for i,r in enumerate(ROWS) for j,c in enumerate(r) if c=='B')
DELTA={'UP':(-1,0),'DOWN':(1,0),'LEFT':(0,-1),'RIGHT':(0,1)}
MIR={'LEFT':'RIGHT','RIGHT':'LEFT','UP':'UP','DOWN':'DOWN'}
def stp(st,act):
    a,b=st; da=DELTA[act]; db=DELTA[MIR[act]]
    na=(a[0]+da[0],a[1]+da[1]); nb=(b[0]+db[0],b[1]+db[1])
    if na not in CONT or na==b or na==nb: na=a
    if nb not in CONT or nb==a or nb==na: nb=b
    return (na,nb)
def bfs(start):
    dist={start:()}; q=deque([start])
    while q:
        s=q.popleft()
        for act in DELTA:
            t=stp(s,act)
            if t not in dist: dist[t]=dist[s]+(act,); q.append(t)
    return dist
def reach(dist,cells):
    best=None
    for o in (cells,(cells[1],cells[0])):
        if o in dist and (best is None or len(dist[o])<len(best)): best=(dist[o],o)
    return best
