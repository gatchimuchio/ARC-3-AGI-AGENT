                if prevR is not None: r=max(r,prevR+2)
                newpos[key(b)]=(b[0],b[1],r-3,r,b[4]); prevR=r
        return (bt,Tn,tuple(newpos.get(key(b),b) for b in bl))
    d = -6 if act=='UP' else 6
