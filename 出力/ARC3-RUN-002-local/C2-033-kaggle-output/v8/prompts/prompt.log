import itertools, collections
ARENA_R=(12,41); ARENA_C=(17,46); L wall=18
def apply(act, S):
    bt,T,bl=S
    band=(bt+2,bt+3)
    def inband(b): return b[0]<=band[1] and b[1]>=band[0]
    if act in ('LEFT','RIGHT'):
        Tn = max(T-6,16) if act=='LEFT' else min(T+6,46)
        nb=[]
        caps=[b for b in bl if inband(b) and b[3]<=T]   # behind tip, in band
        caps_sorted=sorted(caps,key=lambda b:-b[2])
        newpos={}
        if act=='RIGHT':
            prevL=None
            for i,b in enumerate(caps_sorted):
                tgt=Tn-1-6*i
                r=min(max(b[3],tgt),45)
                if prevL is not None: r=min(r,prevL-2)
                l=r-3
                newpos[(b[0],b[1],b[2],b[3])]=(b[0],b[1],l,r)
                prevL=l
        else:
            # pull left; process leftmost first for blocking
            prevR=None
            for i,b in enumerate(sorted(caps,key=lambda b:b[2])):
                tgt=Tn-1-6*i
                r=max(min(b[3],tgt),18+3)
                if prevR is not None: r=max(r,prevR+2)
                l=r-3
                newpos[(b[0],b[1],b[2],b[3])]=(b[0],b[1],l,r)
                prevR=r
        for b in bl:
            k=(b[0],b[1],b[2],b[3])
            nb.append(newpos.get(k,b))
        return (bt,Tn,tuple(nb))
    d = -6 if act=='UP' else 6
    btn = bt+d
    if btn<12 or btn>36: return None
    nb0=(btn+2,btn+3)
    def inb(b,band): return b[0]<=band[1] and b[1]>=band[0]
    caps=[b for b in bl if inb(b,band) and b[3]<=T and b[2]>=16]
    others=[b for b in bl if b not in caps]
    # others overlapping new band within span -> push or block
    pushed={}
    for b in others:
        if inb(b,nb0) and b[3]<=T and b[2]>=16:
            pushed[(b[0],b[1],b[2],b[3])]=(b[0]+d,b[1]+d,b[2],b[3])
    def pos(b):
        k=(b[0],b[1],b[2],b[3])
        return pushed.get(k,b)
    final=[]
    for b in caps:
        final.append((b[0]+d,b[1]+d,b[2],b[3]))
    for b in others:
        final.append(pos(b))
    # validity: all inside arena, no overlaps
    for b in final:
        if b[0]<ARENA_R[0] or b[1]>ARENA_R[1] or b[2]<18 or b[3]>45: return None
    cells=set()
    for b in final:
        for r in range(b[0],b[1]+1):
            for c in range(b[2],b[3]+1):
                if (r,c) in cells: return None
                cells.add((r,c))
    return (btn,T,tuple(final))

def connected(S):
    bt,T,bl=S; band=(bt+2,bt+3)
    return [b for b in bl if b[0]<=band[1] and b[1]>=band[0] and b[3]<=T and b[2]>=16]
def goal(S):
    bt,T,bl=S
    d={b[4]:b for b in bl}
    if len(bl)<3: return False
    R,N,B=d['R'],d['N'],d['b']
    if not (R[2]==18 and N[2]==24 and B[2]==30): return False
    if not (R[0]==N[0]==B[0]): return False
    band=(bt+2,bt+3)
    if not (R[0]<=band[1] and R[1]>=band[0]): return False
    return T>=34
INIT=(36,22,(('R',19,22,42,45),('b',25,28,42,45),('N',31,34,42,45)))
q=collections.deque([(INIT,())]); seen={INIT}
found=None; expanded=0
while q and not found:
    S,path=q.popleft(); expanded+=1
    if goal(S): found=(S,path); break
    for a in ('UP','DOWN','LEFT','RIGHT'):
        S2=apply(a,S)
        if S2 is None or S2 in seen: continue
        seen.add(S2); q.popleft if False else None
        q.append((S2,path+(a,)))
print('expanded',expanded,'states',len(seen))
if found: print('PLAN len',len(found[1]),found[1]); print(found[0])
else: print('no plan; sample states', len(seen))
