def pc2(frame):
    for n in frame.segmentation['nodes']:
        if n['color']=='b' and n['pixels']==24:
            b=n['boundary']; rs=[p[0] for p in b]; cs=[p[1] for p in b]
            return ((min(rs)-8)//6,(min(cs)-8)//6)
def gc2(frame):
    a=frame.ascii.split('\n'); pts=[(r,c) for r in range(6,64) for c in range(64) if a[r][c]=='g']
    if not pts: return None
    r=min(x for x,_ in pts); c=min(y for _,y in pts)
    return ((r-8)//6,(c-8)//6)
