def gridmap(frame, n=8, off=8):
    rows=frame.ascii.split('\n'); out=[]
    for i in range(n):
        line=''
        for j in range(n):
            cnt={}
            for r in range(off+6*i, off+6*i+5):
                for c in range(off+6*j, off+6*j+5):
                    ch=rows[r][c]; cnt[ch]=cnt.get(ch,0)+1
            tot=sum(cnt.values()); dom=max(cnt,key=cnt.get)
            if cnt[dom]>=20: line+=dom
            else: line+='?'
        out.append(line)
    return out
