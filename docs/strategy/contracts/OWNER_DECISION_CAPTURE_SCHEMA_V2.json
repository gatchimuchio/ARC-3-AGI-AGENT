{
  "$id": "https://gatchimuchio.invalid/schemas/owner-decision-capture-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_transition": {
      "minLength": 1,
      "type": "string"
    },
    "capture_is_mechanical": {
      "const": true
    },
    "captured_by": {
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "minLength": 1,
      "type": "string"
    },
    "decision_basis": {
      "const": "OWNER_STANDING_AUTHORIZATION"
    },
    "digest_excluded_fields": {
      "const": [
        "owner_decision_content_digest"
      ],
      "type": "array"
    },
    "gate_result_digest": {
      "pattern": "^[a-z0-9][a-z0-9_.-]*:[0-9a-f]{64}$",
      "type": "string"
    },
    "gate_status": {
      "const": "PASS"
    },
    "owner_decision_content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "arc3-owner-decision-capture-v2"
    },
    "source_instruction_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_instruction_ref": {
      "minLength": 1,
      "type": "string"
    },
    "standing_authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "standing_authorization_path": {
      "minLength": 1,
      "type": "string"
    },
    "target_artifact_digest": {
      "pattern": "^[a-z0-9][a-z0-9_.-]*:[0-9a-f]{64}$",
      "type": "string"
    },
    "target_evidence_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "owner_decision_id",
    "source_instruction_ref",
    "source_instruction_digest",
    "standing_authorization_path",
    "standing_authorization_digest",
    "decision_basis",
    "target_artifact_digest",
    "target_evidence_commit",
    "gate_result_digest",
    "gate_status",
    "allowed_transition",
    "decision",
    "reason_codes",
    "captured_by",
    "capture_is_mechanical",
    "digest_excluded_fields",
    "owner_decision_content_digest"
  ],
  "title": "OwnerDecisionCaptureFromStandingAuthorization",
  "type": "object"
}
