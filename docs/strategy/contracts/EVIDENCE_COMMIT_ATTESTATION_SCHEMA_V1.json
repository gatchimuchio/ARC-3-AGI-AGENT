{
  "$id": "https://gatchimuchio.invalid/schemas/evidence-commit-attestation-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "attestation_role": {
      "const": "EVIDENCE_COMMIT_BINDING"
    },
    "evidence_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "evidence_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "implementation_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "implementation_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "owner_approval": {
      "enum": [
        "NOT_ESTABLISHED",
        "ESTABLISHED_FOR_ENTRY_ONLY",
        "ESTABLISHED_FOR_PHASE_RESULT"
      ],
      "type": "string"
    },
    "phase_id": {
      "minLength": 1,
      "type": "string"
    },
    "phase_state_path": {
      "minLength": 1,
      "type": "string"
    },
    "phase_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "arc3-evidence-commit-attestation-v1"
    },
    "self_reference_avoided": {
      "const": true
    },
    "work_block_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "attestation_role",
    "phase_id",
    "work_block_id",
    "implementation_commit",
    "implementation_tree",
    "evidence_commit",
    "evidence_tree",
    "evidence_payload_digest",
    "phase_state_path",
    "phase_state_sha256",
    "owner_approval",
    "approval_commit",
    "self_reference_avoided"
  ],
  "title": "EvidenceCommitAttestation",
  "type": "object"
}
